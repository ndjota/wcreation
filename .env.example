# Zona horaria por defecto (Argentina)
TZ=America/Argentina/Buenos_Aires

# --- Supabase (Cloud) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: si no se define, el API deriva `${SUPABASE_URL}/auth/v1/.well-known/jwks.json`
SUPABASE_JWKS_URL=
# Para `bash scripts/supabase-apply-migrations.sh` (link automático si no corriste `supabase link`)
SUPABASE_PROJECT_REF=
# Conexión directa Postgres del proyecto (opcional: scripts/seed-dev.sh SQL completo)
SUPABASE_DB_URL=

# --- API (Etapa 2) ---
API_HOST=0.0.0.0
API_PORT=3001
API_URL=http://127.0.0.1:3001
# Mínimo 32 caracteres; misma clave debe usar apps/api y apps/mqtt-bridge para verificar cadenas de eventos
EVENT_SIGNING_KEY=cambiar-por-secreto-largo-de-al-menos-32-caracteres
# URL pública de la PWA (enlaces en emails / QR)
PUBLIC_APP_URL=https://wcreation.ndjota.io
# Base del API para enlaces técnicos de verificación (misma máquina en dev)
APP_LINK_API_URL=http://127.0.0.1:3001
# Opcional: firma de reportes PDF (por defecto se usa EVENT_SIGNING_KEY)
REPORT_SIGNING_KEY=

# --- Puertos host del docker-compose.dev.yml (por defecto 5433 y 6379 según Etapa 1) ---
# Si ya tenés Postgres o Redis en esos puertos, cambiá los valores (p. ej. 15433 / 16379).
WCREATION_PG_PORT=5433
WCREATION_REDIS_PORT=6379
WCREATION_EMQX_DASHBOARD_PORT=18083
WCREATION_MAILHOG_UI_PORT=8025

# --- Base de datos Timescale en VPS (y desarrollo local) ---
VPS_DATABASE_URL=postgres://postgres:wcreation_dev@localhost:5433/wcreation

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MQTT / EMQX ---
MQTT_BROKER_URL=mqtts://127.0.0.1:8883
MQTT_CA_CERT_PATH=./certs/ca/ca-chain-verify-clients.pem
MQTT_SERVER_CERT_PATH=./certs/broker/server.crt
MQTT_SERVER_KEY_PATH=./certs/broker/server.key
# Certificados cliente para mqtt-bridge (CN=SN-BRIDGE-001; generado por scripts/seed-dev.sh)
MQTT_CA_PATH=./certs/broker/cacert.pem
MQTT_CERT_PATH=./certs/devices/SN-BRIDGE-001/device.crt
MQTT_KEY_PATH=./certs/devices/SN-BRIDGE-001/device.key
MQTT_CLIENT_ID=wcreation-mqtt-bridge
WCREATION_TENANT_ID=00000000-0000-0000-0000-0000000000aa

# --- Seed Supabase (`bash scripts/supabase-seed.sh`) ---
SEED_SUPERADMIN_EMAIL=admin@tu-dominio.com
SEED_OWNER_EMAIL=owner-demo@wcreation.local
SEED_RESP_1_EMAIL=resp1-demo@wcreation.local
SEED_RESP_2_EMAIL=resp2-demo@wcreation.local
SEED_USER_PASSWORD=WcreationDev123!

# --- E2E (`bash scripts/test-e2e.sh`) ---
E2E_USER_EMAIL=owner-demo@wcreation.local
E2E_USER_PASSWORD=WcreationDev123!
E2E_DEVICE_ID=a1111111-1111-1111-1111-111111111111

# --- Email ---
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=wcreation_bot

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@wcreation.ndjota.io

# --- PWA (Etapa 3) — variables VITE_* se inyectan en build; en dev Vite usa proxy /api → API ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_PUBLIC_PATENTE_REF=Modelo de utilidad en trámite

# --- API producción (Etapa 5) ---
# Orígenes CORS permitidos (coma). Si omitís en prod, default https://wcreation.ndjota.io
CORS_ORIGINS=https://wcreation.ndjota.io

# --- Workers: health HTTP interno (Docker / red privada) ---
HEALTH_LISTEN_PORT=9090

# --- Backups (scripts/backup-production.sh en el VPS) ---
# BACKUP_DIR=/var/backups/wcreation
# BACKUP_GPG_PASSPHRASE=
# RCLONE_REMOTE=r2remote:wcreation/prod
# TRAEFIK_DYNAMIC_DIR=/etc/dokploy/traefik/dynamic
# WCREATION_CERTS_DIR=/etc/wcreation/certs

# --- Supabase: test RLS (Vitest) ---
# SUPABASE_DB_URL=postgres://postgres:...@db.xxx.supabase.co:5432/postgres

# --- Dokploy / EMQX (solo servidor) ---
# EMQX_DASHBOARD_PASSWORD=
# TRAEFIK_EMQX_BASIC_AUTH=admin:$$apr1$$....   # htpasswd; en .env real escapar $$ según Dokploy
